{
  "$source": {
    "HIG": "https://developer.apple.com/design/human-interface-guidelines/materials (revision 2025-09-09)",
    "APPLE-WEB": "measured on apple.com (references/apple-web/site-patterns.md)",
    "FN": "field notes (validated production values)",
    "UIKIT": "UIKit label colours (not stated on any HIG page)",
    "CONV": "apple-skill web convention"
  },
  "note": "The HIG gives no blur radii or tint opacities. The only Apple number is the 35% dimming layer.",
  "families": {
    "src": "HIG",
    "liquidGlass": { "layer": "functional (controls, navigation) — never content", "variants": ["regular", "clear"], "useSparingly": true,
      "transientException": "slider/toggle take the glass look only while being activated" },
    "standard": { "layer": "content", "iOS": ["ultraThin", "thin", "regular (default)", "thick"], "chooseBy": "semantic meaning, never apparent colour" }
  },
  "glassVariants": {
    "src": "HIG",
    "regular": "default; most system components; text-heavy surfaces (alerts, sidebars, popovers); whenever the background could hurt legibility",
    "clear": "only over visually rich media (photos, video)",
    "clearDimming": { "value": "rgb(0 0 0 / 0.35)", "when": "underlying content is bright; not needed on dark content or AVKit controls" }
  },
  "vibrancy": {
    "src": "HIG",
    "iOS": { "labels": ["label", "secondaryLabel", "tertiaryLabel", "quaternaryLabel"], "fills": ["fill", "secondaryFill", "tertiaryFill"], "separator": ["separator"],
      "rule": "quaternaryLabel not on thin/ultraThin (contrast too low)" },
    "visionOS": { "label": "standard text", "secondaryLabel": "footnotes, subtitles", "tertiaryLabel": "inactive elements only" },
    "neverOnMaterials": "gray palette colours (e.g. systemGray3) for text/glyphs"
  },
  "tvOS": {
    "src": "HIG",
    "ultraThin": "full-screen views needing a light scheme",
    "thin": "overlays partially covering content, light scheme",
    "regular": "overlays partially covering content",
    "thick": "overlays partially covering content, dark scheme"
  },
  "visionOS": { "src": "HIG", "windowMaterial": "glass (system, not modifiable)", "darkMode": "none — glass adapts to luminance behind it",
    "preferTranslucency": true, "thin": "interactive elements, selected items", "regular": "section separation (sidebar, grouped table)", "thick": "dark element on a regular background" },
  "macOS": { "src": "HIG", "blendingModes": ["behindWindow", "withinWindow"], "web": "withinWindow = CSS backdrop-filter; behindWindow impossible in a browser tab" },
  "watchOS": { "src": "HIG", "rule": "keep the default material background of full-screen modal sheets" },
  "web": {
    "filter": { "value": "saturate(180%) blur(20px)", "src": "APPLE-WEB" },
    "standardTint": {
      "src": "CONV (regular = APPLE-WEB nav bar)",
      "light": { "ultraThin": "rgb(255 255 255 / .40)", "thin": "rgb(255 255 255 / .60)", "regular": "rgb(250 250 252 / .80)", "thick": "rgb(250 250 252 / .92)" },
      "dark":  { "ultraThin": "rgb(22 22 23 / .40)",   "thin": "rgb(22 22 23 / .60)",   "regular": "rgb(22 22 23 / .80)",   "thick": "rgb(22 22 23 / .92)" }
    },
    "glass": {
      "src": "CONV from FN principles §12",
      "regular": { "light": "rgb(250 250 252 / .68)", "dark": "rgb(22 22 23 / .62)", "filter": "saturate(180%) blur(16px)", "edge": "1px light top highlight + faint ring" },
      "clear": { "light": "rgb(255 255 255 / .10)", "dark": "rgb(0 0 0 / .10)", "filter": "saturate(150%) blur(6px)" }
    },
    "onMaterialText": {
      "src": "APPLE-WEB (label, secondary light) + UIKIT",
      "light": { "label": "#1D1D1F", "secondary": "#6E6E73", "tertiary": "rgb(60 60 67 / .30)", "quaternary": "rgb(60 60 67 / .18)" },
      "dark":  { "label": "#F5F5F7", "secondary": "rgb(235 235 245 / .60)", "tertiary": "rgb(235 235 245 / .30)", "quaternary": "rgb(235 235 245 / .16)" }
    },
    "opaqueFallback": { "light": "#FAFAFC", "dark": "#161617", "src": "APPLE-WEB", "when": "prefers-reduced-transparency: reduce" },
    "increasedContrast": { "src": "CONV", "tintOpacity": { "ultraThin": 0.70, "thin": 0.82, "regular": 0.92, "thick": 0.97, "glass": 0.90 }, "border": "1px" },
    "veil": { "src": "APPLE-WEB", "filter": "blur(10px)", "dark": "rgb(0 0 0 / .40)", "light": "rgb(255 255 255 / .30) (CONV)" },
    "maxGlassSurfacesPerView": { "value": 4, "src": "CONV (HIG: sparingly)" }
  }
}
